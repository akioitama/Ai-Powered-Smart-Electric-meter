# --- Core ---
APP_NAME=AI Meter API
ENV=dev
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://aimeter:aimeter@localhost:5432/aimeter

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- MQTT ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false

# --- Bootstrap admin (created on first run if no users exist) ---
ADMIN_EMAIL=admin@aimeter.com
ADMIN_PASSWORD=admin1234
ADMIN_NAME=System Admin

# --- Voltage thresholds (defaults; per-meter overrides in DB) ---
DEFAULT_LOW_V=200
DEFAULT_HIGH_V=250
