# --- Required ---

# Postgres connection string (Vercel Postgres / Neon / Supabase / local Postgres).
# Vercel Postgres exposes this as POSTGRES_URL — copy it into DATABASE_URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# Used to sign session JWTs. Generate with: `openssl rand -base64 48`
JWT_SECRET=replace-me-with-a-long-random-secret

# --- Bootstrap admin (auto-created on first request) ---
ADMIN_EMAIL=admin@aimeter.com
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Administrator

# --- Optional ---
# Absolute base URL for server-side fetches in production.
# On Vercel this is auto-derived from VERCEL_URL — leave unset.
# NEXT_PUBLIC_SITE_URL=https://aimeter.example.com
